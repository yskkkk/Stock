// 세력 바닥·바람개비·상투 + 일봉·주봉 MA + 책 매집봉 — TradingView Pine v6

//@version=6
indicator("세력+MA+매집", shorttitle="세력통합", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══ 1·일봉/주봉 이평선 (독립) ═══════════════════════════════════════════
grpMaDisp = "1·이평선 — 표시"
showMa          = input.bool(true, "이평선 사용", group=grpMaDisp, tooltip="OFF면 MA 계산·표시 전부 끔. 다른 지표와 무관")
dispMaLines     = input.bool(true, "MA 선", group=grpMaDisp)
dispMaCross     = input.bool(true, "골든·데드 교차점", group=grpMaDisp)
dispMaWatermark = input.bool(true, "선 위 기간 숫자", group=grpMaDisp)
dispMaLegend    = input.bool(true, "우하단 범례", group=grpMaDisp)

grpMaTf = "1·이평선 — 타임프레임"
tfMode = input.string("일봉+주봉", "그릴 MA", options=["일봉+주봉", "일봉만", "주봉만"], group=grpMaTf)

grpMaStyle = "1·이평선 — 선 스타일"
smoothWeekly = input.bool(true, "주봉 선형 보간", group=grpMaStyle, tooltip="일·분봉에서 주봉 MA 계단 제거. 교차 판정은 확정 주봉값")
brightTransp = input.int(0, "활성 TF 투명도", minval=0, maxval=90, group=grpMaStyle)
dimTransp    = input.int(72, "비활성 TF 투명도", minval=30, maxval=95, group=grpMaStyle)
wmStep       = input.int(42, "기간 숫자 간격(봉)", minval=12, maxval=150, group=grpMaStyle)

// ══ 2·상투·바닥 (독립) ═════════════════════════════════════════════════
grpForceDisp = "2·상투·바닥 — 표시"
showForce         = input.bool(true, "상투·바닥 탐지", group=grpForceDisp, tooltip="OFF면 패턴 계산·마커 전부 끔. 다른 지표와 무관")
dispWBottom       = input.bool(true, "W 바닥확인", group=grpForceDisp)
dispBottomClassic = input.bool(true, "바닥·전형", group=grpForceDisp)
dispBottomVar     = input.bool(true, "바닥·변주", group=grpForceDisp)
dispPinBear       = input.bool(true, "하락 바람개비", group=grpForceDisp)
dispPinBull       = input.bool(true, "상승 바람개비", group=grpForceDisp)
dispTop           = input.bool(true, "상투", group=grpForceDisp)
dispPivot         = input.bool(true, "변곡점(대기)", group=grpForceDisp)
dispZones         = input.bool(true, "손절·분할매수 박스", group=grpForceDisp)
dispZoneLabels    = input.bool(true, "구간 가격 라벨", group=grpForceDisp)
dispBg            = input.bool(true, "바닥·상투 봉 배경", group=grpForceDisp)
forceConfirmedOnly = input.bool(true, "확정봉만 마커", group=grpForceDisp)

grpTf = "2·상투·바닥 — 타임프레임"
tfAuto         = input.bool(true, "차트 TF 자동 보정", group=grpTf, tooltip="주/일/분봉별 갭·RVOL·하락% 자동")
needWeeklyConf = input.bool(false, "주봉 W 강조", group=grpTf, tooltip="ON=주봉에도 패턴 있을 때 W 마커")

grpScore = "2·상투·바닥 — 점수"
forceMinScore  = input.int(50, "최소 점수", minval=0, maxval=100, group=grpScore, tooltip="0=전부. 50=보통. 70+=엄격")
showScoreLabel = input.bool(true, "구간 라벨에 점수", group=grpScore)

grpCore = "2·상투·바닥 — 민감도·거래량"
forcePreset  = input.string("보통", "민감도", options=["느슨", "보통", "엄격"], group=grpCore)
maxBodyPct   = input.float(35.0, "변곡 몸통/전체(%)", minval=10.0, maxval=50.0, step=1.0, group=grpCore)
minGapPct    = input.float(0.3, "최소 갭(%)", minval=0.0, maxval=5.0, step=0.1, group=grpCore)
volLen       = input.int(20, "거래량 이평(봉)", minval=5, maxval=100, group=grpCore)
minRvol      = input.float(1.2, "③번봉 RVOL", minval=0.8, maxval=3.0, step=0.05, group=grpCore)
needDrop     = input.bool(true, "하락 추세 선행", group=grpCore)
dropLookback = input.int(20, "하락 참조(봉)", minval=5, maxval=120, group=grpCore)
minDropPct   = input.float(5.0, "최소 하락(%)", minval=1.0, maxval=40.0, step=0.5, group=grpCore)

grpPat = "2·상투·바닥 — 패턴 종류"
showBottom     = input.bool(true, "바닥(전형·3봉)", group=grpPat)
showBottomVar  = input.bool(true, "바닥 변주", group=grpPat)
showPinwheel   = input.bool(true, "바람개비", group=grpPat)
showTop        = input.bool(true, "상투", group=grpPat)
allowNoGap     = input.bool(true, "갭 없는 바닥 허용", group=grpPat)
allowFallBull  = input.bool(true, "하락양봉 변곡 허용", group=grpPat)

grpTrade = "2·상투·바닥 — 매매 구간"
showSlZone   = input.bool(true, "손절·분할 구간 계산", group=grpTrade)
extendZone   = input.int(8, "박스 우측 연장(봉)", minval=0, maxval=60, group=grpTrade)
maxZones     = input.int(15, "최대 박스 수", minval=1, maxval=100, group=grpTrade)
showLabels   = input.bool(true, "구간 텍스트 라벨", group=grpTrade)

grpCol = "2·상투·바닥 — 색상"
cBottom  = input.color(color.new(#E53935, 0), "바닥", group=grpCol)
cBottomV = input.color(color.new(#FF7043, 0), "변주 바닥", group=grpCol)
cWBottom = input.color(color.new(#C62828, 0), "W 주봉확인", group=grpCol)
cPinUp   = input.color(color.new(#43A047, 0), "상승 바람개비", group=grpCol)
cPinDn   = input.color(color.new(#1E88E5, 0), "하락 바람개비", group=grpCol)
cTop     = input.color(color.new(#8E24AA, 0), "상투", group=grpCol)
cSl      = input.color(color.new(#F44336, 30), "손절선", group=grpCol)
cZone    = input.color(color.new(#E53935, 88), "분할매수 박스", group=grpCol)

// ══ 3·매집봉 (독립) ═══════════════════════════════════════════════════
grpAccumDisp = "3·매집봉 — 표시"
showAccum          = input.bool(true, "매집 탐지", group=grpAccumDisp, tooltip="OFF면 매집 계산·마커 전부 끔. 다른 지표와 무관")
dispAccum          = input.bool(true, "매집 ▲ 마커", group=grpAccumDisp)
accumConfirmedOnly = input.bool(true, "확정봉만 마커", group=grpAccumDisp)

grpAccumCore = "3·매집봉 — 민감도·거래량"
accumPreset    = input.string("보통", "민감도", options=["느슨", "보통", "엄격"], group=grpAccumCore)
accumVolLen    = input.int(20, "거래량 이평(봉)", minval=5, maxval=60, group=grpAccumCore)
accumMinRvol   = input.float(1.8, "매집 RVOL", minval=1.2, maxval=4.0, step=0.1, group=grpAccumCore)
accumVolMaUp   = input.bool(true, "거래량 이평 상승 가산", group=grpAccumCore)
accumNeedDrop  = input.bool(true, "하락 선행", group=grpAccumCore)
accumDropLb    = input.int(40, "하락 참조(봉)", minval=10, maxval=120, group=grpAccumCore)
accumMinDrop   = input.float(8.0, "최소 하락(%)", minval=3.0, maxval=40.0, step=0.5, group=grpAccumCore)

grpAccumCost = "3·매집봉 — 본전"
accumUseCost   = input.bool(true, "본전 맥락 사용", group=grpAccumCost)
accumCostTol   = input.float(3.0, "본전 허용(%)", minval=1.0, maxval=8.0, step=0.5, group=grpAccumCost)
accumPivotLen  = input.int(5, "스윙 저점(봉)", minval=3, maxval=15, group=grpAccumCost)
accumRecover   = input.int(5, "본전 회복(봉)", minval=3, maxval=10, group=grpAccumCost)
accumNeedCost  = input.bool(false, "본전 터치 필수", group=grpAccumCost)

grpAccumShape = "3·매집봉 — 캔들 형태"
accumUpperPct  = input.float(25.0, "윗꼬리/전체(%)", minval=10.0, maxval=60.0, step=1.0, group=grpAccumShape)
accumBodyPct   = input.float(45.0, "작은 몸통/전체(%)", minval=15.0, maxval=70.0, step=1.0, group=grpAccumShape)
accumSmallBull = input.bool(true, "소양봉 허용", group=grpAccumShape)

grpAccumConsec = "3·매집봉 — 연속·점수"
accumConsecWin = input.int(3, "연속 창(봉)", minval=2, maxval=10, group=grpAccumConsec)
accumMinConsec = input.int(2, "연속 최소(회)", minval=1, maxval=5, group=grpAccumConsec)
accumMinScore  = input.int(55, "최소 점수", minval=0, maxval=100, group=grpAccumConsec)

grpAccumFilter = "3·매집봉 — 상투(분산) 제외"
accumRiseLb    = input.int(30, "선행 상승(봉)", minval=10, maxval=80, group=grpAccumFilter)
accumMinRise   = input.float(15.0, "선행 상승(%)", minval=5.0, maxval=60.0, step=1.0, group=grpAccumFilter)
accumPeakRvol  = input.float(2.5, "분산봉 RVOL", minval=1.5, maxval=5.0, step=0.1, group=grpAccumFilter)

grpAccumCol = "3·매집봉 — 색상"
cAccum = input.color(color.new(#D84315, 0), "매집 마커", group=grpAccumCol)

// ── 책 매집봉 감지 (세력·security 이전 — 단독 스크립트와 동일 순서) ───
float accumEffRvol = accumPreset == "엄격" ? math.max(accumMinRvol, 2.2) : accumPreset == "느슨" ? math.min(accumMinRvol, 1.5) : accumMinRvol
int accumEffConsec = accumPreset == "엄격" ? math.max(accumMinConsec, 2) : accumMinConsec
int accumEffMinScore = accumPreset == "느슨" ? math.min(accumMinScore, 45) : accumPreset == "엄격" ? math.max(accumMinScore, 65) : accumMinScore

float aVolMa = math.sum(volume, accumVolLen) / float(accumVolLen)
float aRvol = aVolMa > 0 ? volume / aVolMa : 1.0
bool aVolMaUp = aVolMa > aVolMa[3]

float aRng = high - low
float aBody = math.abs(close - open)
float aBodyPct = aRng > 0 ? aBody / aRng * 100.0 : 100.0
float aUpperPct = aRng > 0 ? (high - math.max(open, close)) / aRng * 100.0 : 0.0

float aHiRef = ta.highest(high, accumDropLb)
float aDropPct = aHiRef > 0 ? (aHiRef - close) / aHiRef * 100.0 : 0.0
bool aHadDrop = aDropPct >= accumMinDrop

float aLoRise = ta.lowest(low, accumRiseLb)
float aRisePct = aLoRise > 0 ? (close - aLoRise) / aLoRise * 100.0 : 0.0
bool aHadRise = aRisePct >= accumMinRise

var float aCostBasis = na
float aPlVal = ta.pivotlow(low, accumPivotLen, accumPivotLen)
bool aPlHit = not na(aPlVal)
if accumUseCost and aPlHit
    float aPlRvol = aVolMa[accumPivotLen] > 0 ? volume[accumPivotLen] / aVolMa[accumPivotLen] : 1.0
    float aPlDrop = aHiRef[accumPivotLen] > 0 ? (aHiRef[accumPivotLen] - close[accumPivotLen]) / aHiRef[accumPivotLen] * 100.0 : 0.0
    bool aPlDropOk = not accumNeedDrop or aPlDrop >= accumMinDrop * 0.75
    if aPlRvol >= accumEffRvol * 0.9 and aPlDropOk
        aCostBasis := aPlVal

bool aTouchCost = accumUseCost and not na(aCostBasis) and aCostBasis > 0 and low <= aCostBasis * (1.0 + accumCostTol / 100.0) and high >= aCostBasis * (1.0 - accumCostTol / 100.0)

var int aCostTouches = 0
if aTouchCost and not aTouchCost[1]
    aCostTouches += 1

var int aBreachBar = na
if accumUseCost and not na(aCostBasis) and close < aCostBasis and (na(aBreachBar) or close[1] >= aCostBasis)
    aBreachBar := bar_index
if accumUseCost and not na(aCostBasis) and close >= aCostBasis
    aBreachBar := na

int aSinceBreach = not na(aBreachBar) ? bar_index - aBreachBar : 10000
bool aRecover5d = accumUseCost and not na(aCostBasis) and aSinceBreach > 0 and aSinceBreach <= accumRecover and close > aCostBasis

bool aShapeUpper = aUpperPct >= accumUpperPct
bool aShapeSmall = aBodyPct <= accumBodyPct
bool aShapeSmallBull = accumSmallBull and close > open and aBodyPct <= accumBodyPct * 0.85
bool aShapeOk = aShapeUpper or aShapeSmall or aShapeSmallBull

bool aVolOk = aRvol >= accumEffRvol and (not accumVolMaUp or aVolMaUp or aRvol >= accumEffRvol * 1.2)
bool aPeakDistrib = aHadRise and aRvol >= accumPeakRvol and close > open and aBodyPct >= 55.0
bool aAccumRaw = aVolOk and aShapeOk and not aPeakDistrib and (not accumNeedDrop or aHadDrop)

int aConsecCnt = 0
for i = 0 to accumConsecWin - 1
    float arv = aVolMa[i] > 0 ? volume[i] / aVolMa[i] : 1.0
    float arng = high[i] - low[i]
    float aup = arng > 0 ? (high[i] - math.max(open[i], close[i])) / arng * 100.0 : 0.0
    float abd = arng > 0 ? math.abs(close[i] - open[i]) / arng * 100.0 : 100.0
    bool ash = aup >= accumUpperPct or abd <= accumBodyPct
    if arv >= accumEffRvol * 0.92 and ash
        aConsecCnt += 1

bool aConsecOk = aConsecCnt >= accumEffConsec
bool aCtxOk = not accumNeedCost or aTouchCost or aRecover5d

bool aScoreAcc = aAccumRaw and aCtxOk
float aScore = 0.0
if aScoreAcc
    aScore += math.min(30.0, aRvol / accumEffRvol * 18.0)
    aScore += aShapeUpper ? 15.0 : aShapeSmall ? 10.0 : 6.0
    aScore += accumVolMaUp and aVolMaUp ? 12.0 : 0.0
    aScore += aTouchCost ? 20.0 : 0.0
    aScore += aRecover5d ? 15.0 : 0.0
    aScore += aConsecOk ? 12.0 : 0.0
    aScore += aCostTouches >= 2 ? 10.0 : aCostTouches >= 1 ? 5.0 : 0.0
aScore := math.min(100.0, aScore)

bool anyAccum = showAccum and aAccumRaw and aCtxOk and aScore >= accumEffMinScore
bool accumBarOk = not accumConfirmedOnly or barstate.isconfirmed

// ── 세력 캔들 TF ──────────────────────────────────────────────────────
int tfSec = timeframe.in_seconds()
bool chartIsWeekly = tfSec >= 604800
bool chartIsDaily  = tfSec >= 86400 and not chartIsWeekly

f_tune(bool forWeekly) =>
    float bBase = forWeekly ? 38.0 : chartIsDaily ? 35.0 : 32.0
    float gBase = forWeekly ? 0.12 : chartIsDaily ? 0.25 : 0.18
    int vBase   = forWeekly ? 12 : volLen
    float rBase = forWeekly ? 1.1 : chartIsDaily ? 1.2 : 1.15
    int dLb     = forWeekly ? 26 : chartIsDaily ? 20 : dropLookback
    float dPct  = forWeekly ? 8.0 : chartIsDaily ? 5.0 : minDropPct
    int extBase = forWeekly ? 14 : chartIsDaily ? 8 : extendZone
    float bAdj = forcePreset == "엄격" ? math.min(bBase, 28.0) : forcePreset == "느슨" ? bBase * 1.12 : bBase
    float gAdj = forcePreset == "엄격" ? math.max(gBase, 0.4) : gBase
    float rAdj = forcePreset == "엄격" ? math.max(rBase, 1.35) : forcePreset == "느슨" ? math.min(rBase, 1.0) : rBase
    float dAdj = forcePreset == "엄격" ? dPct * 1.15 : forcePreset == "느슨" ? dPct * 0.75 : dPct
    [tfAuto ? bAdj : maxBodyPct, tfAuto ? gAdj : minGapPct, tfAuto ? vBase : volLen, tfAuto ? rAdj : minRvol, tfAuto ? dLb : dropLookback, tfAuto ? dAdj : minDropPct, extBase]

[effBody, effGap, effVolLen, effRvol, effDropLb, effDropPct, effExtend] = f_tune(chartIsWeekly)
[wBody, wGap, wVolLen, wRvolMin, wDropLb, wDropPct, wExtend] = f_tune(true)

// ── 세력 캔들 유틸 ───────────────────────────────────────────────────
f_rng() =>
    high - low

f_body() =>
    math.abs(close - open)

f_bodyPctOff(int off) =>
    float r = f_rng()[off]
    r > 0 ? f_body()[off] / r * 100.0 : 100.0

f_bull() =>
    close > open

f_bear() =>
    close < open

f_inflection(int off, float bodyMax) =>
    f_bodyPctOff(off) <= bodyMax

f_gapDn(int off, float gapMin) =>
    gapMin <= 0 ? open[off] < close[off + 1] : close[off + 1] > 0 and (close[off + 1] - open[off]) / close[off + 1] * 100.0 >= gapMin

f_gapUp(int off, float gapMin) =>
    gapMin <= 0 ? open[off] > close[off + 1] : close[off + 1] > 0 and (open[off] - close[off + 1]) / close[off + 1] * 100.0 >= gapMin

f_fallBull(int off) =>
    open[off] < close[off + 1] and f_bull()[off]

f_riseBear(int off) =>
    open[off] > close[off + 1] and f_bear()[off]

f_pivot2(float bodyMax) =>
    f_inflection(1, bodyMax) or (allowFallBull and f_fallBull(1))

f_pivot2Top(float bodyMax) =>
    f_inflection(1, bodyMax) or f_riseBear(1)

f_gapStory(float gapMin) =>
    bool gDual = f_gapDn(1, gapMin) and f_gapUp(0, gapMin)
    bool gAny = f_gapDn(1, gapMin) or f_gapUp(0, gapMin)
    bool gBreak = close > high[1]
    bool gTri = low[1] <= low[2] and low[1] <= low[0]
    [gDual, gAny, gBreak, gTri, gDual or gAny or gBreak or gTri]

f_scoreBottom(bool anyB, int tagCode, bool gDual, bool gAny, bool gBreak, bool gTri, float rvol0, float rvolMin, float body2, float bodyMax, float dropPct, float dropMin) =>
    float sc = 0.0
    if anyB
        sc += gDual ? 25.0 : gAny ? 12.0 : 0.0
        sc += gBreak ? 20.0 : 0.0
        sc += gTri ? 10.0 : 0.0
        sc += rvol0 >= rvolMin ? math.min(20.0, rvol0 / rvolMin * 12.0) : 0.0
        sc += body2 <= bodyMax ? math.min(15.0, (bodyMax - body2) / math.max(bodyMax, 1.0) * 15.0) : 0.0
        sc += dropPct >= dropMin ? math.min(10.0, dropPct / math.max(dropMin, 0.1) * 8.0) : 0.0
        sc += tagCode == 1 ? 8.0 : tagCode == 2 ? 5.0 : tagCode == 5 ? 4.0 : 2.0
    math.min(100.0, sc)

f_detect(float bodyMax, float gapMin, int vLen, float rvolMin, int dropLb, float dropMin) =>
    float volMa0 = ta.sma(volume, vLen)
    float rvol0 = volMa0 > 0 ? volume / volMa0 : 1.0
    float hiRef = ta.highest(high, dropLb)
    float loRef = ta.lowest(low, dropLb)
    float dropPct0 = hiRef > 0 ? (hiRef - close) / hiRef * 100.0 : 0.0
    float risePct0 = loRef > 0 ? (close - loRef) / loRef * 100.0 : 0.0
    bool hadDrop0 = dropPct0 >= dropMin
    bool hadRise0 = risePct0 >= dropMin

    bool ctxDrop = not needDrop or hadDrop0
    bool ctxRise = not needDrop or hadRise0
    bool volOk = rvol0 >= rvolMin

    [gDual, gAny, gBreak, gTri, gapOk] = f_gapStory(gapMin)
    float body2 = f_bodyPctOff(1)

    bool bClassic =
         showBottom and ctxDrop and volOk and gapOk and
         f_bear()[2] and f_pivot2(bodyMax) and f_bull()

    bool bNoGap =
         showBottomVar and allowNoGap and ctxDrop and volOk and gapOk and
         f_bear()[2] and f_inflection(1, bodyMax) and f_bull() and
         not gDual and not gAny

    bool bGapPivot =
         showBottomVar and ctxDrop and volOk and gapOk and
         f_bear()[2] and f_inflection(1, bodyMax) and f_gapUp(1, gapMin) and
         f_bull() and f_gapUp(0, gapMin)

    bool bFallBull =
         showBottomVar and allowFallBull and ctxDrop and volOk and gapOk and
         f_bear()[2] and f_fallBull(1) and f_bull()

    bool bGapFallBull =
         showBottomVar and allowFallBull and ctxDrop and volOk and gapOk and
         f_bear()[2] and f_fallBull(1) and f_fallBull(0)

    bool anyB = bClassic or bNoGap or bGapPivot or bFallBull or bGapFallBull

    int tagCode =
         bClassic and gDual ? 1 :
         bClassic ? 5 :
         bGapPivot ? 2 :
         bFallBull ? 3 :
         bGapFallBull ? 4 :
         bNoGap ? 5 : 0

    float score = f_scoreBottom(anyB, tagCode, gDual, gAny, gBreak, gTri, rvol0, rvolMin, body2, bodyMax, dropPct0, dropMin)

    bool pBear = showPinwheel and ctxDrop and f_bear()[2] and f_pivot2(bodyMax) and f_bear()
    bool pBull = showPinwheel and ctxRise and f_bull()[2] and f_pivot2Top(bodyMax) and f_bull()
    bool tClassic = showTop and ctxRise and volOk and f_bull()[2] and f_pivot2Top(bodyMax) and f_bear() and f_gapUp(1, gapMin) and f_gapDn(0, gapMin)
    bool pivotWait = (f_inflection(0, bodyMax) or (allowFallBull and f_fallBull(0))) and f_bear()[1] and ctxDrop

    [anyB, bClassic, tagCode, pBear, pBull, tClassic, pivotWait, low[1], close, high[1], rvol0, score]

f_tag(int code) =>
    code == 1 ? "바닥·전형" :
     code == 2 ? "바닥·갭변곡" :
     code == 3 ? "바닥·하락양" :
     code == 4 ? "바닥·갭하양" :
     code == 5 ? "바닥·무갭" : ""

// ── 세력 캔들 감지 ───────────────────────────────────────────────────
[anyBottomRaw, bottomClassicRaw, bottomCodeRaw, pinBearRaw, pinBullRaw, topClassicRaw, pivotFormingRaw, slL, zoneTop, zoneBotSl, rvol3, scoreRaw] =
     f_detect(effBody, effGap, effVolLen, effRvol, effDropLb, effDropPct)

[wAnyRaw, wClassicRaw, wCodeRaw, wPinBear, wPinBull, wTopRaw, wPivotRaw, wSl, wTop, wBot, wRvolW, wScore] =
     request.security(syminfo.tickerid, "W", f_detect(wBody, wGap, wVolLen, wRvolMin, wDropLb, wDropPct), barmerge.gaps_off, barmerge.lookahead_off)

bool passScore = scoreRaw >= forceMinScore
bool anyBottom = showForce and anyBottomRaw and passScore
bool bottomClassic = anyBottom and bottomClassicRaw
bool wConfirmed = showForce and needWeeklyConf and not chartIsWeekly and anyBottom and wAnyRaw and wScore >= forceMinScore
int bottomCode = anyBottom ? bottomCodeRaw : 0
bool pinBear = showForce and pinBearRaw and passScore
bool pinBull = showForce and pinBullRaw and passScore
bool topClassic = showForce and topClassicRaw
bool pivotForming = showForce and pivotFormingRaw
int bottomScore = anyBottom ? int(math.round(scoreRaw)) : 0

string bottomTag = f_tag(bottomCode) + (showScoreLabel and anyBottom ? " " + str.tostring(bottomScore) + "pt" : "")

bool forceBarOk = not forceConfirmedOnly or barstate.isconfirmed

// ── MA 로직 ──────────────────────────────────────────────────────────
bool showBoth = tfMode == "일봉+주봉"
bool showDailyTf = showBoth or tfMode == "일봉만"
bool showWeeklyTf = showBoth or tfMode == "주봉만"
bool showDaily = showMa and dispMaLines and showDailyTf
bool showWeekly = showMa and dispMaLines and showWeeklyTf
bool showDailyCross = showMa and dispMaCross and showDailyTf
bool showWeeklyCross = showMa and dispMaCross and showWeeklyTf
bool showDailyWm = showMa and dispMaWatermark and showDailyTf
bool showWeeklyWm = showMa and dispMaWatermark and showWeeklyTf

color dailySpecA = #76FF03
color dailySpecZ = #F50057
color weeklySpecA = #40C4FF
color weeklySpecZ = #7E57C2
color c5_d = #F50057
color c20_d = #FF6D00
color c60_d = #FFEA00
color c120_d = #76FF03
color c5_w = color.from_gradient(5, 5, 120, weeklySpecA, weeklySpecZ)
color c20_w = color.from_gradient(20, 5, 120, weeklySpecA, weeklySpecZ)
color c60_w = color.from_gradient(60, 5, 120, weeklySpecA, weeklySpecZ)
color c120_w = color.from_gradient(120, 5, 120, weeklySpecA, weeklySpecZ)

bool weeklyPrimary = timeframe.isweekly or timeframe.ismonthly
bool dailyPrimary = not weeklyPrimary

int dAlpha = showBoth and dailyPrimary ? brightTransp : showBoth ? dimTransp : brightTransp
int wAlpha = showBoth and weeklyPrimary ? brightTransp : showBoth ? dimTransp : brightTransp

bool needWeeklySmooth = smoothWeekly and not timeframe.isweekly and not timeframe.ismonthly

f_interp_week(float curr, float prev) =>
    int t0 = time("W")
    int t1 = time_close("W")
    float span = float(t1 - t0)
    float frac = span > 0 ? math.min(math.max((time - t0) / span, 0.0), 1.0) : 1.0
    prev + (curr - prev) * frac

f_week_plot(float currDev, float prevFin, float step) =>
    needWeeklySmooth ? f_interp_week(currDev, prevFin) : step

float ma5_d = request.security(syminfo.tickerid, "D", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_off)
float ma20_d = request.security(syminfo.tickerid, "D", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float ma60_d = request.security(syminfo.tickerid, "D", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_off)
float ma120_d = request.security(syminfo.tickerid, "D", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_off)

float ma5_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_off)
float ma20_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float ma60_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_off)
float ma120_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_off)
float ma5_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_on)
float ma20_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_on)
float ma60_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_on)
float ma120_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_on)
float ma5_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 5)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma20_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma60_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 60)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma120_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 120)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma5_w = f_week_plot(ma5_w_curr, ma5_w_prev, ma5_w_step)
float ma20_w = f_week_plot(ma20_w_curr, ma20_w_prev, ma20_w_step)
float ma60_w = f_week_plot(ma60_w_curr, ma60_w_prev, ma60_w_step)
float ma120_w = f_week_plot(ma120_w_curr, ma120_w_prev, ma120_w_step)

bool gold_5_20_d = ta.crossover(ma5_d, ma20_d)
bool dead_5_20_d = ta.crossunder(ma5_d, ma20_d)
bool gold_20_120_d = ta.crossover(ma20_d, ma120_d)
bool dead_20_120_d = ta.crossunder(ma20_d, ma120_d)

bool gold_5_20_w = ta.crossover(ma5_w_step, ma20_w_step)
bool dead_5_20_w = ta.crossunder(ma5_w_step, ma20_w_step)
bool gold_20_120_w = ta.crossover(ma20_w_step, ma120_w_step)
bool dead_20_120_w = ta.crossunder(ma20_w_step, ma120_w_step)

color color_5_20_d = gold_5_20_d ? color.new(color.green, dAlpha) : dead_5_20_d ? color.new(color.red, dAlpha) : na
color color_20_120_d = gold_20_120_d ? color.new(color.green, dAlpha) : dead_20_120_d ? color.new(color.red, dAlpha) : na
color color_5_20_w = gold_5_20_w ? color.new(color.green, wAlpha) : dead_5_20_w ? color.new(color.red, wAlpha) : na
color color_20_120_w = gold_20_120_w ? color.new(color.green, wAlpha) : dead_20_120_w ? color.new(color.red, wAlpha) : na

// ── MA 선·교차 (뒤 레이어) ───────────────────────────────────────────
plot(showDaily ? ma5_d : na, color=color.new(c5_d, dAlpha), linewidth=2, title="[일] 5 MA")
plot(showDaily ? ma20_d : na, color=color.new(c20_d, dAlpha), linewidth=2, title="[일] 20 MA")
plot(showDaily ? ma60_d : na, color=color.new(c60_d, dAlpha), linewidth=2, title="[일] 60 MA")
plot(showDaily ? ma120_d : na, color=color.new(c120_d, dAlpha), linewidth=2, title="[일] 120 MA")

plot(showWeekly ? ma5_w : na, color=color.new(c5_w, wAlpha), linewidth=2, title="[주] 5 MA")
plot(showWeekly ? ma20_w : na, color=color.new(c20_w, wAlpha), linewidth=2, title="[주] 20 MA")
plot(showWeekly ? ma60_w : na, color=color.new(c60_w, wAlpha), linewidth=2, title="[주] 60 MA")
plot(showWeekly ? ma120_w : na, color=color.new(c120_w, wAlpha), linewidth=2, title="[주] 120 MA")

plot(showDailyCross and (gold_5_20_d or dead_5_20_d) ? ma5_d : na, style=plot.style_circles, linewidth=5, color=color_5_20_d, title="[일] 5-20 교차점")
plot(showDailyCross and (gold_20_120_d or dead_20_120_d) ? ma20_d : na, style=plot.style_circles, linewidth=5, color=color_20_120_d, title="[일] 20-120 교차점")
plot(showWeeklyCross and (gold_5_20_w or dead_5_20_w) ? ma5_w_step : na, style=plot.style_circles, linewidth=5, color=color_5_20_w, title="[주] 5-20 교차점")
plot(showWeeklyCross and (gold_20_120_w or dead_20_120_w) ? ma20_w_step : na, style=plot.style_circles, linewidth=5, color=color_20_120_w, title="[주] 20-120 교차점")

// ── 세력 캔들 구간 ───────────────────────────────────────────────────
float zoneLblAtr = ta.atr(14)
int zoneLblClashBars = 6
int zoneLblXStep = 3
float zoneLblHalf = zoneLblAtr * 1.5
float zoneLblGap = zoneLblAtr * 0.4
float zoneLblStep = zoneLblAtr * 1.35
float zoneLblPad = zoneLblAtr * 0.15
float zoneLblMaxReach = zoneLblAtr * 3.8

type ZoneLblRec
    int b
    int t
    float sl
    float top
    float bot
    float sigLo
    float sigHi
    string tag
    bool isBtm
    color col

type LblSlot
    int xb
    float yMin
    float yMax

var box[] zoneBoxes = array.new_box()
var line[] slLines = array.new_line()
var line[] lblConnLines = array.new_line()
var label[] zoneLbls = array.new_label()
var ZoneLblRec[] lblRecs = array.new<ZoneLblRec>()

f_trimZoneBoxes() =>
    while array.size(zoneBoxes) > maxZones
        box.delete(array.shift(zoneBoxes))
    while array.size(slLines) > maxZones
        line.delete(array.shift(slLines))

f_trimLblRecs() =>
    while array.size(lblRecs) > maxZones
        array.shift(lblRecs)

f_pushLblRec(int b, int t, float sl, float top, float bot, float sigLo, float sigHi, string tag, bool isBtm, color col) =>
    array.push(lblRecs, ZoneLblRec.new(b, t, sl, top, bot, sigLo, sigHi, tag, isBtm, col))
    f_trimLblRecs()

f_clearLblDraw() =>
    while array.size(lblConnLines) > 0
        line.delete(array.shift(lblConnLines))
    while array.size(zoneLbls) > 0
        label.delete(array.shift(zoneLbls))

f_xClash(int xb, LblSlot[] slots) =>
    bool cl = false
    int n = array.size(slots)
    int j = 0
    while j < n
        LblSlot s = array.get(slots, j)
        if math.abs(xb - s.xb) <= zoneLblClashBars
            cl := true
            break
        j += 1
    cl

f_yClash(int xb, float yMin, float yMax, LblSlot[] slots) =>
    bool cl = false
    int n = array.size(slots)
    int j = 0
    while j < n
        LblSlot s = array.get(slots, j)
        if math.abs(xb - s.xb) <= zoneLblClashBars and yMax + zoneLblPad >= s.yMin and yMin - zoneLblPad <= s.yMax
            cl := true
            break
        j += 1
    cl

f_findXBar(int sigB, LblSlot[] slots) =>
    int xBar = sigB
    for attempt = 0 to 8
        int mag = attempt == 0 ? 0 : int(math.ceil(attempt / 2.0))
        int sgn = attempt % 2 == 1 ? -1 : 1
        xBar := sigB + (attempt == 0 ? 0 : mag * sgn * zoneLblXStep)
        if not f_xClash(xBar, slots)
            break
    xBar

f_lblTxt(ZoneLblRec r) =>
    r.tag + "\n손절 " + str.tostring(r.sl, format.mintick) + "\n분할 " + str.tostring(r.bot, format.mintick) + "~" + str.tostring(r.top, format.mintick)

f_drawLblRec(ZoneLblRec r, LblSlot[] slots) =>
    int xBar = f_findXBar(r.b, slots)
    float half = zoneLblHalf
    float lblY = na
    float connEnd = na
    float yMin = na
    float yMax = na
    int vLane = 0
    for attempt = 0 to 5
        float reach = math.min(zoneLblGap + zoneLblStep * vLane, zoneLblMaxReach)
        if r.isBtm
            connEnd := r.sigLo - reach
            lblY := connEnd - half
        else
            connEnd := r.sigHi + reach
            lblY := connEnd + half
        yMin := lblY - half
        yMax := lblY + half
        bool candleOk = r.isBtm ? yMax <= r.sigLo - zoneLblGap * 0.2 : yMin >= r.sigHi + zoneLblGap * 0.2
        bool lblOk = not f_yClash(xBar, yMin, yMax, slots)
        if candleOk and lblOk
            break
        vLane += 1
    string txt = f_lblTxt(r)
    string sz = vLane >= 2 ? size.tiny : size.small
    if r.isBtm
        array.push(lblConnLines, line.new(r.b, r.sigLo, xBar, connEnd, xloc=xloc.bar_index, extend=extend.none, color=color.new(r.col, 0), width=2, style=line.style_dotted))
        array.push(zoneLbls, label.new(xBar, lblY, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center, color=color.new(r.col, 15), textcolor=color.white, size=sz))
    else
        array.push(lblConnLines, line.new(r.b, r.sigHi, xBar, connEnd, xloc=xloc.bar_index, extend=extend.none, color=color.new(r.col, 0), width=2, style=line.style_dotted))
        array.push(zoneLbls, label.new(xBar, lblY, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_center, color=color.new(r.col, 15), textcolor=color.white, size=sz))
    LblSlot.new(xBar, yMin, yMax)

f_redrawZoneLbls() =>
    f_clearLblDraw()
    if not (showLabels and dispZoneLabels)
        na
    else
        int visL = chart.left_visible_bar_time
        int visR = chart.right_visible_bar_time
        int n = array.size(lblRecs)
        if n > 0
            LblSlot[] dBSlots = array.new<LblSlot>()
            LblSlot[] dTSlots = array.new<LblSlot>()
            for i = 0 to n - 1
                ZoneLblRec r = array.get(lblRecs, i)
                if r.t >= visL and r.t <= visR and r.isBtm
                    array.push(dBSlots, f_drawLblRec(r, dBSlots))
            for i = 0 to n - 1
                ZoneLblRec r = array.get(lblRecs, i)
                if r.t >= visL and r.t <= visR and not r.isBtm
                    array.push(dTSlots, f_drawLblRec(r, dTSlots))

f_drawZone(int bLeft, int tLeft, float sl, float zTop, float zBot, color zCol, string tag, int extBars) =>
    f_trimZoneBoxes()
    int tfMs = timeframe.in_seconds() * 1000
    int tRight = tLeft + extBars * tfMs
    float top = math.max(zTop, zBot)
    float bot = math.min(zTop, zBot)
    if showSlZone and dispZones
        array.push(slLines, line.new(tLeft, sl, tRight, sl, xloc=xloc.bar_time, color=cSl, width=2, style=line.style_dashed))
        array.push(zoneBoxes, box.new(tLeft, top, tRight, bot, xloc=xloc.bar_time, border_color=color.new(zCol, 40), bgcolor=cZone, border_width=1))

bool zoneLblOn = showLabels and dispZoneLabels

if anyBottom and forceBarOk and dispZones
    f_drawZone(bar_index, time, slL, zoneTop, zoneBotSl, wConfirmed ? cWBottom : cBottom, bottomTag, effExtend)
    if zoneLblOn
        f_pushLblRec(bar_index, time, slL, zoneTop, zoneBotSl, low, high, bottomTag, true, wConfirmed ? cWBottom : cBottom)

if topClassic and forceBarOk and dispZones
    f_drawZone(bar_index, time, zoneTop, zoneTop, zoneBotSl, cTop, "상투", effExtend)
    if zoneLblOn
        f_pushLblRec(bar_index, time, zoneTop, zoneTop, zoneBotSl, low, high, "상투", false, cTop)

if barstate.islast and zoneLblOn
    f_redrawZoneLbls()

// ── 세력 캔들·매집 마커 ───────────────────────────────────────────────
plotshape(forceBarOk and dispWBottom and anyBottom and bottomClassic and wConfirmed and not zoneLblOn, title="W바닥확인", style=shape.triangleup, location=location.belowbar, color=cWBottom, size=size.large, text="W")
plotshape(forceBarOk and dispBottomClassic and anyBottom and bottomClassic and not wConfirmed and not zoneLblOn, title="바닥·전형", style=shape.triangleup, location=location.belowbar, color=cBottom, size=size.normal, text="바닥")
plotshape(forceBarOk and dispBottomVar and anyBottom and not bottomClassic and not zoneLblOn, title="바닥·변주", style=shape.triangleup, location=location.belowbar, color=cBottomV, size=size.small, text="변주")
plotshape(forceBarOk and dispPinBear and pinBear, title="하락 바람개비", style=shape.triangledown, location=location.abovebar, color=cPinDn, size=size.tiny, text="↓")
plotshape(forceBarOk and dispPinBull and pinBull, title="상승 바람개비", style=shape.triangleup, location=location.belowbar, color=cPinUp, size=size.tiny, text="↑")
plotshape(forceBarOk and dispTop and topClassic and not zoneLblOn, title="상투", style=shape.triangledown, location=location.abovebar, color=cTop, size=size.normal, text="상투")
plotshape(forceBarOk and dispPivot and pivotForming, title="변곡점", style=shape.cross, location=location.belowbar, color=color.new(#FFC107, 0), size=size.tiny)
plotshape(accumBarOk and dispAccum and anyAccum, title="책 매집봉", style=shape.triangleup, location=location.belowbar, color=cAccum, size=size.normal, text="매집")

bgcolor(dispBg and forceBarOk and anyBottom ? color.new(wConfirmed ? cWBottom : cBottom, 92) : dispBg and forceBarOk and topClassic ? color.new(cTop, 93) : na)

// ── MA 워터마크·범례 ─────────────────────────────────────────────────
int wmPh = int(math.max(wmStep / 5, 3))
int wmTa = math.min(dAlpha + 40, 88)
int wmTw = math.min(wAlpha + 40, 88)

if showMa and showDailyWm and not na(ma5_d) and bar_index % wmStep == 0
    label.new(bar_index, ma5_d, "5", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c5_d, wmTa), size=size.tiny)
if showMa and showDailyWm and not na(ma20_d) and bar_index % wmStep == wmPh
    label.new(bar_index, ma20_d, "20", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c20_d, wmTa), size=size.tiny)
if showMa and showDailyWm and not na(ma60_d) and bar_index % wmStep == wmPh * 2
    label.new(bar_index, ma60_d, "60", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c60_d, wmTa), size=size.tiny)
if showMa and showDailyWm and not na(ma120_d) and bar_index % wmStep == wmPh * 3
    label.new(bar_index, ma120_d, "120", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c120_d, wmTa), size=size.tiny)
if showMa and showWeeklyWm and not na(ma5_w) and bar_index % wmStep == 1
    label.new(bar_index, ma5_w, "5", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c5_w, wmTw), size=size.tiny)
if showMa and showWeeklyWm and not na(ma20_w) and bar_index % wmStep == wmPh + 1
    label.new(bar_index, ma20_w, "20", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c20_w, wmTw), size=size.tiny)
if showMa and showWeeklyWm and not na(ma60_w) and bar_index % wmStep == wmPh * 2 + 1
    label.new(bar_index, ma60_w, "60", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c60_w, wmTw), size=size.tiny)
if showMa and showWeeklyWm and not na(ma120_w) and bar_index % wmStep == wmPh * 3 + 1
    label.new(bar_index, ma120_w, "120", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c120_w, wmTw), size=size.tiny)

var table legend = table.new(position.bottom_right, 3, 8, bgcolor=na, frame_color=color.new(color.gray, 70), border_width=1)

f_leg_label(int row, string label) =>
    table.cell(legend, 0, row, label, text_color=color.silver, text_size=size.tiny, text_halign=text.align_left)

f_leg_ma(int row, string label, color cD, color cW) =>
    f_leg_label(row, label)
    table.cell(legend, 1, row, showDailyTf ? "━━" : "", text_color=color.new(cD, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, row, showWeeklyTf ? "━━" : "", text_color=color.new(cW, wAlpha), text_size=size.tiny)

if barstate.islast and showMa and dispMaLegend
    string smoothHint = needWeeklySmooth ? " · 주봉보간" : ""
    string modeHint = (showBoth ? (weeklyPrimary ? "강조: 주봉" : "강조: 일봉") : tfMode) + smoothHint
    table.cell(legend, 0, 0, "MA 색상", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(legend, 1, 0, showDailyTf ? "일봉" : "", text_color=color.new(dailySpecA, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 0, showWeeklyTf ? "주봉" : "", text_color=color.new(weeklySpecA, wAlpha), text_size=size.tiny)
    f_leg_ma(1, "5일", c5_d, c5_w)
    f_leg_ma(2, "20일", c20_d, c20_w)
    f_leg_ma(3, "60일", c60_d, c60_w)
    f_leg_ma(4, "120일", c120_d, c120_w)
    f_leg_label(5, "교차")
    table.cell(legend, 1, 5, showDailyTf ? "골든 ●" : "", text_color=color.new(color.green, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 5, showWeeklyTf ? "골든 ●" : "", text_color=color.new(color.green, wAlpha), text_size=size.tiny)
    f_leg_label(6, "")
    table.cell(legend, 1, 6, showDailyTf ? "데드 ●" : "", text_color=color.new(color.red, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 6, showWeeklyTf ? "데드 ●" : "", text_color=color.new(color.red, wAlpha), text_size=size.tiny)
    table.cell(legend, 0, 7, modeHint, text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 7, showDailyTf ? "5↔20" : "", text_color=color.new(color.gray, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 7, showWeeklyTf ? "20↔120" : "", text_color=color.new(color.gray, wAlpha), text_size=size.tiny)

// ── 알림 ─────────────────────────────────────────────────────────────
alertcondition(showForce and anyBottom, "바닥 캔들", "세력 바닥 캔들 — 점수·주봉 확인 통과")
alertcondition(showForce and wConfirmed, "주봉확인 바닥", "일봉+주봉 동시 바닥 캔들")
alertcondition(showForce and bottomClassic, "바닥·전형", "전형 바닥 패턴")
alertcondition(showForce and pinBear, "하락 바람개비", "하락 바람개비")
alertcondition(showForce and topClassic, "상투 캔들", "세력 상투 캔들")
alertcondition(showAccum and anyAccum, "책 매집봉", "책 매집봉 신호")
alertcondition(showMa and gold_5_20_d, "일봉 5-20 골든", "일봉 5·20 MA 골든크로스")
alertcondition(showMa and dead_5_20_d, "일봉 5-20 데드", "일봉 5·20 MA 데드크로스")
alertcondition(showMa and gold_20_120_d, "일봉 20-120 골든", "일봉 20·120 MA 골든크로스")
alertcondition(showMa and dead_20_120_d, "일봉 20-120 데드", "일봉 20·120 MA 데드크로스")
alertcondition(showMa and gold_5_20_w, "주봉 5-20 골든", "주봉 5·20 MA 골든크로스")
alertcondition(showMa and dead_5_20_w, "주봉 5-20 데드", "주봉 5·20 MA 데드크로스")
alertcondition(showMa and gold_20_120_w, "주봉 20-120 골든", "주봉 20·120 MA 골든크로스")
alertcondition(showMa and dead_20_120_w, "주봉 20-120 데드", "주봉 20·120 MA 데드크로스")

// ── 데이터 윈도우 ────────────────────────────────────────────────────
plot(anyBottom ? 1 : 0, "바닥 신호", display=display.data_window)
plot(anyBottomRaw ? 1 : 0, "바닥(raw)", display=display.data_window)
plot(bottomScore, "바닥 점수", display=display.data_window)
plot(wScore, "주봉 점수", display=display.data_window)
plot(wAnyRaw ? 1 : 0, "주봉(raw)", display=display.data_window)
plot(rvol3, "③ RVOL", display=display.data_window)
plot(anyAccum ? 1 : 0, "매집 신호", display=display.data_window)
plot(aScore, "매집 점수", display=display.data_window)
plot(aRvol, "매집 RVOL", display=display.data_window)
