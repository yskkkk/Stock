//@version=5
indicator("일봉·주봉 MA 정확 접점 (골든/데드 구분)", overlay=true, max_labels_count=500)

string grpDisp = "표시"
string tfMode = input.string("일봉+주봉", "표시 TF", options=["일봉+주봉", "일봉만", "주봉만"], group=grpDisp)
bool showLegend = input.bool(true, "범례 표시 (우하단)", group=grpDisp)
bool showWatermark = input.bool(true, "선 워터마크 (5·20·60·120)", group=grpDisp)
int wmStep = input.int(42, "워터마크 간격(봉)", minval=12, maxval=150, group=grpDisp)
int wmCount = input.int(9, "워터마크 개수", minval=3, maxval=14, group=grpDisp)
bool smoothWeekly = input.bool(true, "주봉 선형 보간 (일·분봉)", group=grpDisp, tooltip="전주 확정 MA → 금주 MA를 주 안에서 직선 보간합니다(계단·뾰족 모서리 제거). 교차점 판정·표시는 확정 주봉 MA(lookahead_off)를 유지합니다.")
int brightTransp = input.int(0, "활성 TF 투명도", minval=0, maxval=90, group=grpDisp)
int dimTransp = input.int(72, "비활성 TF 투명도", minval=30, maxval=95, group=grpDisp)

bool showBoth = tfMode == "일봉+주봉"
bool showDaily = showBoth or tfMode == "일봉만"
bool showWeekly = showBoth or tfMode == "주봉만"

// 스펙트럼 — 일봉: 노랑→주황→빨강(따뜻한 계열) / 주봉: 시안→파랑→보라(차가운 계열), 5→120으로 hue 이동
color dailySpecA = #FFEE58
color dailySpecZ = #C62828
color weeklySpecA = #40C4FF
color weeklySpecZ = #7E57C2
color c5_d = color.from_gradient(5, 5, 120, dailySpecA, dailySpecZ)
color c20_d = color.from_gradient(20, 5, 120, dailySpecA, dailySpecZ)
color c60_d = color.from_gradient(60, 5, 120, dailySpecA, dailySpecZ)
color c120_d = color.from_gradient(120, 5, 120, dailySpecA, dailySpecZ)
color c5_w = color.from_gradient(5, 5, 120, weeklySpecA, weeklySpecZ)
color c20_w = color.from_gradient(20, 5, 120, weeklySpecA, weeklySpecZ)
color c60_w = color.from_gradient(60, 5, 120, weeklySpecA, weeklySpecZ)
color c120_w = color.from_gradient(120, 5, 120, weeklySpecA, weeklySpecZ)

// 주봉 이상 차트 → 주봉 강조 / 그 외(분봉·일봉) → 일봉 강조
bool weeklyPrimary = timeframe.isweekly or timeframe.ismonthly
bool dailyPrimary = not weeklyPrimary

int dAlpha = showBoth and dailyPrimary ? brightTransp : showBoth ? dimTransp : brightTransp
int wAlpha = showBoth and weeklyPrimary ? brightTransp : showBoth ? dimTransp : brightTransp

bool needWeeklySmooth = smoothWeekly and not timeframe.isweekly and not timeframe.ismonthly

// 주봉 MA — 전주 확정 → 금주(진행 중) 선형 보간 (표시용만 lookahead_on)
f_interp_week(float curr, float prev) =>
    int t0 = time("W")
    int t1 = time_close("W")
    float span = float(t1 - t0)
    float frac = span > 0 ? math.min(math.max((time - t0) / span, 0.0), 1.0) : 1.0
    prev + (curr - prev) * frac

f_week_plot(float currDev, float prevFin, float step) =>
    needWeeklySmooth ? f_interp_week(currDev, prevFin) : step

// === 일봉 MA ===
float ma5_d = request.security(syminfo.tickerid, "D", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_off)
float ma20_d = request.security(syminfo.tickerid, "D", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float ma60_d = request.security(syminfo.tickerid, "D", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_off)
float ma120_d = request.security(syminfo.tickerid, "D", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_off)

// === 주봉 MA — 교차=확정(step), 선=전주→금주 보간(표시) ===
float ma5_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_off)
float ma20_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off)
float ma60_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_off)
float ma120_w_step = request.security(syminfo.tickerid, "W", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_off)
float ma5_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 5), barmerge.gaps_off, barmerge.lookahead_on)
float ma20_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_on)
float ma60_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 60), barmerge.gaps_off, barmerge.lookahead_on)
float ma120_w_curr = request.security(syminfo.tickerid, "W", ta.sma(close, 120), barmerge.gaps_off, barmerge.lookahead_on)
float ma5_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 5)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma20_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma60_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 60)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma120_w_prev = request.security(syminfo.tickerid, "W", ta.sma(close, 120)[1], barmerge.gaps_off, barmerge.lookahead_on)
float ma5_w = f_week_plot(ma5_w_curr, ma5_w_prev, ma5_w_step)
float ma20_w = f_week_plot(ma20_w_curr, ma20_w_prev, ma20_w_step)
float ma60_w = f_week_plot(ma60_w_curr, ma60_w_prev, ma60_w_step)
float ma120_w = f_week_plot(ma120_w_curr, ma120_w_prev, ma120_w_step)

// === 일봉 교차 ===
bool gold_5_20_d = ta.crossover(ma5_d, ma20_d)
bool dead_5_20_d = ta.crossunder(ma5_d, ma20_d)
bool gold_20_120_d = ta.crossover(ma20_d, ma120_d)
bool dead_20_120_d = ta.crossunder(ma20_d, ma120_d)

// === 주봉 교차 (step 값 — 왜곡 없음) ===
bool gold_5_20_w = ta.crossover(ma5_w_step, ma20_w_step)
bool dead_5_20_w = ta.crossunder(ma5_w_step, ma20_w_step)
bool gold_20_120_w = ta.crossover(ma20_w_step, ma120_w_step)
bool dead_20_120_w = ta.crossunder(ma20_w_step, ma120_w_step)

color color_5_20_d = gold_5_20_d ? color.new(color.green, dAlpha) : dead_5_20_d ? color.new(color.red, dAlpha) : na
color color_20_120_d = gold_20_120_d ? color.new(color.green, dAlpha) : dead_20_120_d ? color.new(color.red, dAlpha) : na
color color_5_20_w = gold_5_20_w ? color.new(color.green, wAlpha) : dead_5_20_w ? color.new(color.red, wAlpha) : na
color color_20_120_w = gold_20_120_w ? color.new(color.green, wAlpha) : dead_20_120_w ? color.new(color.red, wAlpha) : na

// === 일봉 MA 선 ===
plot(showDaily ? ma5_d : na, color=color.new(c5_d, dAlpha), linewidth=2, title="[일] 5 MA")
plot(showDaily ? ma20_d : na, color=color.new(c20_d, dAlpha), linewidth=2, title="[일] 20 MA")
plot(showDaily ? ma60_d : na, color=color.new(c60_d, dAlpha), linewidth=2, title="[일] 60 MA")
plot(showDaily ? ma120_d : na, color=color.new(c120_d, dAlpha), linewidth=2, title="[일] 120 MA")

// === 주봉 MA 선 ===
plot(showWeekly ? ma5_w : na, color=color.new(c5_w, wAlpha), linewidth=2, title="[주] 5 MA")
plot(showWeekly ? ma20_w : na, color=color.new(c20_w, wAlpha), linewidth=2, title="[주] 20 MA")
plot(showWeekly ? ma60_w : na, color=color.new(c60_w, wAlpha), linewidth=2, title="[주] 60 MA")
plot(showWeekly ? ma120_w : na, color=color.new(c120_w, wAlpha), linewidth=2, title="[주] 120 MA")

// === 교차점 ===
plot(showDaily and (gold_5_20_d or dead_5_20_d) ? ma5_d : na, style=plot.style_circles, linewidth=5, color=color_5_20_d, title="[일] 5-20 교차점")
plot(showDaily and (gold_20_120_d or dead_20_120_d) ? ma20_d : na, style=plot.style_circles, linewidth=5, color=color_20_120_d, title="[일] 20-120 교차점")
plot(showWeekly and (gold_5_20_w or dead_5_20_w) ? ma5_w_step : na, style=plot.style_circles, linewidth=5, color=color_5_20_w, title="[주] 5-20 교차점")
plot(showWeekly and (gold_20_120_w or dead_20_120_w) ? ma20_w_step : na, style=plot.style_circles, linewidth=5, color=color_20_120_w, title="[주] 20-120 교차점")

// === 선 워터마크 (선 위 5·20·60·120) ===
var array<label> wmLabels = array.new<label>()

f_wm_text_alpha(int baseAlpha) =>
    math.min(baseAlpha + 40, 88)

f_wm_clear() =>
    int n = array.size(wmLabels)
    if n > 0
        for j = 0 to n - 1
            label.delete(array.get(wmLabels, j))
        array.clear(wmLabels)

f_wm_place(int phase, float ma, string txt, color c, int alpha) =>
    for i = 1 to wmCount
        int off = i * wmStep + phase
        if bar_index >= off
            float y = ma[off]
            if not na(y)
                array.push(wmLabels, label.new(bar_index - off, y, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(c, alpha), size=size.tiny))

if barstate.islast and showWatermark
    f_wm_clear()
    int ph = int(math.max(wmStep / 5, 3))
    if showDaily
        f_wm_place(0, ma5_d, "5", c5_d, f_wm_text_alpha(dAlpha))
        f_wm_place(ph, ma20_d, "20", c20_d, f_wm_text_alpha(dAlpha))
        f_wm_place(ph * 2, ma60_d, "60", c60_d, f_wm_text_alpha(dAlpha))
        f_wm_place(ph * 3, ma120_d, "120", c120_d, f_wm_text_alpha(dAlpha))
    if showWeekly
        f_wm_place(ph / 2, ma5_w, "5", c5_w, f_wm_text_alpha(wAlpha))
        f_wm_place(ph + ph / 2, ma20_w, "20", c20_w, f_wm_text_alpha(wAlpha))
        f_wm_place(ph * 2 + ph / 2, ma60_w, "60", c60_w, f_wm_text_alpha(wAlpha))
        f_wm_place(ph * 3 + ph / 2, ma120_w, "120", c120_w, f_wm_text_alpha(wAlpha))

// === 우하단 범례 (배경 없음 · 차트와 동일 dAlpha/wAlpha) ===
var table legend = table.new(position.bottom_right, 3, 8, bgcolor=na, frame_color=color.new(color.gray, 70), border_width=1)

f_leg_label(int row, string label) =>
    table.cell(legend, 0, row, label, text_color=color.silver, text_size=size.tiny, text_halign=text.align_left)

f_leg_ma(int row, string label, color cD, color cW) =>
    f_leg_label(row, label)
    table.cell(legend, 1, row, showDaily ? "━━" : "", text_color=color.new(cD, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, row, showWeekly ? "━━" : "", text_color=color.new(cW, wAlpha), text_size=size.tiny)

if barstate.islast and showLegend
    string smoothHint = needWeeklySmooth ? " · 주봉보간" : ""
    string modeHint = (showBoth ? (weeklyPrimary ? "강조: 주봉" : "강조: 일봉") : tfMode) + smoothHint
    table.cell(legend, 0, 0, "MA 색상", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(legend, 1, 0, showDaily ? "일봉" : "", text_color=color.new(dailySpecA, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 0, showWeekly ? "주봉" : "", text_color=color.new(weeklySpecA, wAlpha), text_size=size.tiny)
    f_leg_ma(1, "5일", c5_d, c5_w)
    f_leg_ma(2, "20일", c20_d, c20_w)
    f_leg_ma(3, "60일", c60_d, c60_w)
    f_leg_ma(4, "120일", c120_d, c120_w)
    f_leg_label(5, "교차")
    table.cell(legend, 1, 5, showDaily ? "골든 ●" : "", text_color=color.new(color.green, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 5, showWeekly ? "골든 ●" : "", text_color=color.new(color.green, wAlpha), text_size=size.tiny)
    f_leg_label(6, "")
    table.cell(legend, 1, 6, showDaily ? "데드 ●" : "", text_color=color.new(color.red, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 6, showWeekly ? "데드 ●" : "", text_color=color.new(color.red, wAlpha), text_size=size.tiny)
    table.cell(legend, 0, 7, modeHint, text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.cell(legend, 1, 7, showDaily ? "5↔20" : "", text_color=color.new(color.gray, dAlpha), text_size=size.tiny)
    table.cell(legend, 2, 7, showWeekly ? "20↔120" : "", text_color=color.new(color.gray, wAlpha), text_size=size.tiny)
